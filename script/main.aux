\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces A sketch of the considered system. The vector $\mathbf  {m}|_0$ denotes the magnetic moment at $t=0$. One can see that the angle between $\mathbf  {m}$ and $\mathbf  {B}$ at any point in time is the difference between $\beta $ and $\theta $. Since $\cos $ is symmetric on $\mathbb  {R}$, the change of sign as $\mathbf  {m}$ passes $\mathbf  {B}$ is not of concern.}}{17}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:2dramp}{{2.1}{17}{A sketch of the considered system. The vector $\mathbf {m}|_0$ denotes the magnetic moment at $t=0$. One can see that the angle between $\mathbf {m}$ and $\mathbf {B}$ at any point in time is the difference between $\beta $ and $\theta $. Since $\cos $ is symmetric on $\mathbb {R}$, the change of sign as $\mathbf {m}$ passes $\mathbf {B}$ is not of concern}{figure.caption.3}{}}
